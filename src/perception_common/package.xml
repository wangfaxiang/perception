<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perception_common</name>
  <version>0.1.0</version>
  <description>感知侧共用件：运动方向定向检测门控（头文件）+ 契约告警融合节点（/perception/* 三话题唯一发布者）</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>dth_messages</depend>

  <!-- perception_bringup.launch.py 一键启动链路所需的运行期依赖。
       注意：不能在此声明 pothole_detection / cluster —— 它们反向依赖本包，
       声明会形成 colcon 拓扑循环（Unable to order packages topologically）。 -->
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rslidar_sdk</exec_depend>
  <exec_depend>lidar_leveling</exec_depend>
  <exec_depend>ground_segmentation</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
