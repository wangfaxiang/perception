<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>range_image_segmentation</name>
  <version>0.1.0</version>
  <description>Range-image based ground removal and obstacle clustering for RoboSense E1R (144-beam solid-state lidar), adapted from LeGO-LOAM imageProjection.</description>
  <maintainer email="3300626170@qq.com">promote</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>dth_messages</depend>
  <!-- 运行期：launch 需解析 perception_common 共享参数 share 目录；源码用其 motion_state.hpp -->
  <depend>perception_common</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
