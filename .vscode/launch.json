        {
            "name": "Debug warning_fusion (launch)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/perception_common/warning_fusion_node",
            "args": [
                "--ros-args",
                // 共享阈值（edge_danger_dist / obstacle_danger_dist 无代码默认值）只能来自
                // perception_common 的 /** 共享段；节点被 __node:= 改名，故文件里的
                // warning_fusion 专属段不生效（避免调试期真去锁停整车、发生产话题）
                "--params-file", "${workspaceFolder}/install/perception_common/share/perception_common/config/params.yaml",
                "-r", "__node:=debug_warning_fusion",
                // 调试态默认只接调试实例（不碰契约话题 /perception/*）：
                // 边坡接 range_image_segmentation 调试实例，障碍接 cluster 调试实例；
                // 接真实检测实例（生产命名）时改为:
                //   /range_image_segmentation_front/edge_warning_raw, /range_image_segmentation_rear/edge_warning_raw
                //   /cluster_front/obstacle_warning_raw,              /cluster_rear/obstacle_warning_raw
                "-p", "front_edge_topic:=/debug_range_image_seg_front/edge_warning_raw",
                "-p", "rear_edge_topic:=/debug_range_image_seg_rear/edge_warning_raw",
                "-p", "front_obstacle_topic:=/debug_cluster_front/obstacle_warning_raw",
                "-p", "rear_obstacle_topic:=/debug_cluster_rear/obstacle_warning_raw",
                "-p", "edge_warning_topic:=/debug/edge_warning",
                "-p", "obstacle_warning_topic:=/debug/obstacle_warning",
                // 急停也发到调试话题：调试期触发不得真的去锁停整车（生产名 /perception/stop_command）
                "-p", "stop_command_topic:=/debug/stop_command"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/opt/ros/humble/lib:${workspaceFolder}/install/perception_common/lib:${workspaceFolder}/install/dth_messages/lib:${env:LD_LIBRARY_PATH}"
                }
            ],
            "MIMode": "gdb",
