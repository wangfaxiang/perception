{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug pothole_detection_front (launch)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/pothole_detection/pothole_detection_node",
            "args": [
                "--ros-args",
                // 阈值（edge_danger_dist/edge_caution_dist 无代码默认值）只能来自参数文件的 /** 共享段；
                // 本节点名被改为 debug_pothole_det_front，故文件里的节点专属段不会生效
                "--params-file", "${workspaceFolder}/install/perception_common/share/perception_common/config/params.yaml",
                "-r", "__node:=debug_pothole_det_front",
                "-p", "lidar_name:=front",
                "-p", "ditch_ratio_thresh:=9.0",
                "-p", "min_range:=3.0",
                "-p", "voxel_leaf_size:=0.1",
                "-p", "horiz_res_deg:=1.0",
                // 定向检测门控：镜像话题不通/未收到时按停车处理（双向检测）
                // 若本机有真实 cmd 镜像在跑，单独调试检测算法时建议关闭门控或改指向不存在的镜像话题
                // "-p", "motion_gate_enable:=false",
                // "-p", "motion_cmd_topic:=/nonexistent",
                // "-p", "cliff_enable:=true"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/opt/ros/humble/lib:${workspaceFolder}/install/pothole_detection/lib:${workspaceFolder}/install/dth_messages/lib:${workspaceFolder}/install/rslidar_msg/lib:${env:LD_LIBRARY_PATH}"
                }
            ],
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "stopAtEntry": false,
            "preLaunchTask": ""
        },
