{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug pothole_detection_front (launch)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/pothole_detection/pothole_detection_node",
            "args": [
                "--ros-args",
                "-r", "__node:=debug_pothole_det_front",
                "-p", "lidar_name:=front",
                "-p", "ditch_ratio_thresh:=9.0",
                "-p", "min_range:=3.0"                
            ],
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/install/pothole_detection/lib:${workspaceFolder}/install/rslidar_msg/lib:${env:LD_LIBRARY_PATH}"
                }
            ],
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "stopAtEntry": false,
            "preLaunchTask": ""
        },
